<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gripper_camera</name>
  <version>0.1.0</version>
  <description>Virtual Orbbec Gemini 305 passive-stereo RGB-D camera in MuJoCo (image + camera_info topics)</description>
  <maintainer email="sunnyflow4597@gmail.com">RefindHand</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <!-- mujoco and opencv-contrib-python are installed with pip (see README.md) -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
