  <version>0.1.0</version>
  <description>ROHand AP002 pipeline bringup: webcam, pose command, finger nodes with hardware backend, feedback node in one launch</description>
  <maintainer email="lee.bigse0u1@gmail.com">RefindHand</maintainer>
  <license>TODO</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
