<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hand_gui</name>
  <version>0.1.0</version>
  <description>Tactile data collection GUI for the ROHand AP002 pipeline: robot hand view with force arrows, webcam and robot camera views, force plots, episode recording, Hugging Face upload</description>
  <maintainer email="lee.bigse0u1@gmail.com">RefindHand</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>finger_node</exec_depend>
  <exec_depend>hand_tracking</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
